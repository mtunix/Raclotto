{
  "name": "raclotto",
  "version": "0.2.0",
  "private": true,
  "dependencies": {
    "antd": "^6.1.2",
    "axios": "^1.13.2",
    "i18next": "^26.7.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.1.12",
    "react-router": "^8.5.1",
    "swr": "^2.3.8",
    "zustand": "^5.0.9"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "build:static": "tsc -b && vite build --outDir ../static --emptyOutDir",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "gen:api": "cd .. && venv/bin/python -m back.src.api.openapi && cd front && orval",
    "gen:api:check": "npm run gen:api && git diff --exit-code -- ../back/openapi.json src/api/generated && test -z \"$(git status --porcelain -- ../back/openapi.json src/api/generated | tee /dev/stderr)\"",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "jsdom": "^31.0.1",
    "orval": "8.46.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "type": "module"
}
