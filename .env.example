# Copy to .env (git-ignored) and fill in. `python -m back.src.main` and `python -m back.src.dev`
# read it; variables already set in the environment win.

# REQUIRED for the production server. At least 32 bytes, never a value from source. Generate one:
#   venv/bin/python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out. The dev server ignores it and uses its own dev secret.
RACLOTTO_JWT_SECRET=

# Optional. SQLAlchemy URL; default sqlite:///raclotto.db, i.e. instance/raclotto.db under the
# directory the server runs from. Use an absolute path (sqlite:////abs/path/raclotto.db) so the
# server and `venv/bin/alembic` (which reads only the real environment) open the same file.
RACLOTTO_DATABASE_URL=

# Optional. Used only when no user named "admin" exists: creates it with this password. An
# existing admin is never changed. Unset: no admin is created (a warning is logged).
RACLOTTO_ADMIN_PASSWORD=

# Optional. Production listen address; default 127.0.0.1 and 8081 (the frontend dev proxy's
# target). The dev server always binds 127.0.0.1 and only takes the port.
RACLOTTO_HOST=
RACLOTTO_PORT=

# Optional. Gemini key for image generation; without it image generation is unavailable.
GOOGLE_GENAI_API_KEY=
