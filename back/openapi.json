{
  "components": {
    "schemas": {
      "ApiErrorDto": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "id_": {
            "title": "Id",
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApiErrorSourceDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "id_",
          "status",
          "code",
          "title",
          "detail",
          "source"
        ],
        "title": "ApiErrorDto",
        "type": "object"
      },
      "ApiErrorSourceDto": {
        "properties": {
          "pointer": {
            "title": "Pointer",
            "type": "string"
          }
        },
        "required": [
          "pointer"
        ],
        "title": "ApiErrorSourceDto",
        "type": "object"
      },
      "ErrorResponseDto": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ApiErrorDto"
            },
            "title": "Errors",
            "type": "array"
          },
          "jsonapi": {
            "$ref": "#/components/schemas/JsonApiDto"
          }
        },
        "required": [
          "jsonapi",
          "errors"
        ],
        "title": "ErrorResponseDto",
        "type": "object"
      },
      "JsonApiDto": {
        "properties": {
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "JsonApiDto",
        "type": "object"
      },
      "LevelDto": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "label_de": {
            "title": "Label De",
            "type": "string"
          },
          "label_en": {
            "title": "Label En",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "required_experience": {
            "title": "Required Experience",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "label_en",
          "label_de",
          "required_experience"
        ],
        "title": "LevelDto",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Raclotto API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/levels": {
      "get": {
        "operationId": "listLevels",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LevelDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List all levels ordered by required experience.",
        "tags": [
          "levels"
        ]
      }
    },
    "/levels/{level_id}": {
      "get": {
        "operationId": "getLevel",
        "parameters": [
          {
            "in": "path",
            "name": "level_id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LevelDto"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get a level by id.",
        "tags": [
          "levels"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/api"
    }
  ]
}
